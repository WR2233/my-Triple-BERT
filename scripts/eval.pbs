#!/bin/bash
#PBS -N triple_bert_eval
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -W group_list=gr61
#PBS -j oe
#PBS -o logs/
#PBS -m ae
# 宛先は公開リポジトリに残さないよう、投入時に指定する: qsub -M <アドレス> scripts/eval.pbs
# OSRMをバックグラウンド起動(ポート6000)してから finetune/eval.py を実行する。
# 環境変数 (qsub -v KEY=VALUE[,KEY=VALUE]) で条件を変えられる:
#   HOURS   評価する時間帯 (既定: "14 17 20 21 22" = eval.py と同じ)  例: -v HOURS="19"
#   REPEAT  HOURS を何回繰り返すか (既定: 1)。ばらつきの測定用       例: -v REPEAT=8
#   MODEL   重みのパス (既定: parameters/stage2/best.pth)             例: -v MODEL=/path/to/latest.pth
#   DAY     評価する日 (既定: 17)
#   RUN_NAME 出力ディレクトリの名前 (既定: eval)
# 1時間帯あたり約25秒。debug-g(30分)なら、5時間帯 x REPEAT=8 (40エピソード, 約17分)程度まで。
# 出力は ~/tb/runs/<RUN_NAME>_<ジョブID>/ (eval_result.txt, run_info.log, osrm.log)
set -eu
module load apptainer
SIF="$HOME/tb/osrm.sif"
REPO="$HOME/tb/my-Triple-BERT"
HOURS="${HOURS:-14 17 20 21 22}"
REPEAT="${REPEAT:-1}"
DAY="${DAY:-17}"
MODEL="${MODEL:-$REPO/parameters/stage2/best.pth}"
RUN_NAME="${RUN_NAME:-eval}"

ALL_HOURS=""
for r in $(seq 1 "$REPEAT"); do ALL_HOURS="$ALL_HOURS $HOURS"; done

# eval.py は eval_result.txt をカレントに追記するので、実行ごとの専用ディレクトリで実行する
RUN_DIR="$HOME/tb/runs/${RUN_NAME}_${PBS_JOBID%%.*}"
mkdir -p "$RUN_DIR"
cd "$RUN_DIR"

source "$HOME/tb/venv/bin/activate"
{
  echo "job: $PBS_JOBID  host: $(hostname)  start: $(date)"
  echo "commit: $(git -C "$REPO" rev-parse HEAD)"
  echo "model: $MODEL  day: $DAY  hours: $HOURS  repeat: $REPEAT"
  python -c "import torch; print('cuda available:', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"
} | tee -a run_info.log

apptainer exec "$SIF" osrm-routed --algorithm mld --port 6000 "$REPO/data/new-york-latest.osrm" > osrm.log 2>&1 &
OSRM_PID=$!
trap 'kill $OSRM_PID 2>/dev/null || true' EXIT

# OSRMの起動待ち(最大2分)
for i in $(seq 1 60); do
  if curl -s "http://localhost:6000/route/v1/driving/-73.98,40.75;-73.97,40.76" | grep -q '"Ok"'; then break; fi
  sleep 2
done

python "$REPO/finetune/eval.py" --bi_direction --njobs 24 --day "$DAY" --hour $ALL_HOURS \
  --model_path "$MODEL" \
  --demand_path "$REPO/data/yellow_tripdata_2024-07.parquet" \
  --zone_dic_path "$REPO/data/Manhattan_dic.pkl"
echo "finished: $(date)" | tee -a run_info.log
